# MAPro Web 环境变量示例
# 复制本文件为 .env 并填入实际值后，docker compose up 会自动加载

# 数据目录（Docker 内默认 /app/data）
MAPRO_DATA_DIR=/app/data

# 服务监听地址
# 默认 127.0.0.1（仅本机可访问）；Docker 部署需改为 0.0.0.0
MAPRO_WEB_HOST=0.0.0.0

# 服务端口
MAPRO_WEB_PORT=3000
MAPRO_WS_PORT=8081

# 安全：API 鉴权 Token（生产环境 / Docker 暴露端口时务必设置强随机字符串）
# 未设置时 HTTP API 与 WebSocket 均不校验身份，仅供本地 127.0.0.1 开发使用
# MAPRO_API_TOKEN=change-me-to-a-random-token

# CORS 允许的 Origin 列表（逗号分隔）；设置 MAPRO_API_TOKEN 后默认禁止跨域，
# 如需让第三方域名访问 API，需在此处显式放行
# MAPRO_ALLOWED_ORIGINS=https://app.example.com

# 加密敏感数据（API Key 等）的主密钥
# 未设置时回退为明文存储，仅供本地开发使用
MAPRO_MASTER_KEY=change-me-to-a-long-random-master-key

# 阶段 A 最小 Chat 配置（按需启用）
# MAPRO_CHAT_PROVIDER=deepseek
# MAPRO_CHAT_API_KEY=your-api-key
# MAPRO_CHAT_BASE_URL=https://api.deepseek.com
# MAPRO_CHAT_MODEL=deepseek-chat

# Agent 配置（按需启用）
# MAPRO_AGENT_API_KEY=your-agent-api-key
# MAPRO_AGENT_PROVIDER=anthropic
# MAPRO_AGENT_MODEL=claude-sonnet-4-20250514
# MAPRO_AGENT_BASE_URL=https://api.anthropic.com
